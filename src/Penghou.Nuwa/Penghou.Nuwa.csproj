<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

    <PackageId>Penghou.Nuwa</PackageId>
    <Title>Penghou Nuwa</Title>
    <Version>0.2.0</Version>
    <Authors>Penghou.Nuwa contributors</Authors>
    <Description>A repair and recovery pipeline for malformed JSON and structured output produced by language models.</Description>
    <PackageTags>json;json-repair;llm;structured-output;tool-calling;ai</PackageTags>
    <RepositoryUrl>https://github.com/jenolaszlo-sketch/penghou-nuwa</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
